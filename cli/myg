        '{action: "file:share", id: $id, type: $type, role: $role, value: $value}')
      response=$(gas_post "$json_body")
    fi
  elif [[ "$file_subaction" == "unshare" ]]; then
    json_body=$(jq -n \
      --arg id "$fu_id" \
      --arg permission "$fu_permission" \
      '{action: "file:unshare", id: $id, permission: $permission}')
    response=$(gas_post "$json_body")
  elif [[ "$file_subaction" == "delete" ]]; then
    # Get file info first for confirmation message
    file_info=$(gas_get "{\"action\":\"file:props\",\"id\":\"${fu_id}\"}")
    file_name=$(echo "$file_info" | jq -r '.name // empty')
    file_link="https://drive.google.com/file/d/${fu_id}/view"
    if [[ -n "$file_name" ]]; then
      confirm_msg="This will move the file to trash:
${file_name}
${file_link}"
    else
      confirm_msg="This will move the file to trash: id=${fu_id}"
    fi
    require_confirm "$confirm_msg" "myg file delete"
    json_body=$(jq -n \
      --arg id "$fu_id" \
      '{action: "file:delete", id: $id}')
    response=$(gas_post "$json_body")
  elif [[ "$file_subaction" == "diff" ]]; then
    response=$(gas_get "{\"action\":\"file:revision\",\"id\":\"${fu_id}\",\"rev1\":\"${fu_rev1}\",\"rev2\":\"${fu_rev2}\"}")
  elif [[ "$file_subaction" == "history" ]]; then
    response=$(gas_get "{\"action\":\"file:history\",\"id\":\"${fu_id}\",\"max\":\"${fu_max:-20}\"}")
  elif [[ "$file_subaction" == "upload" ]]; then
    if [[ -n "$fu_file" ]]; then
      fu_tmp=$(mktemp)
      base64 -w0 "$fu_file" > "$fu_tmp"
      fu_b64="true"
      fu_mime=$(file -b --mime-type "$fu_file")
    elif [[ ! -t 0 ]]; then
      fu_tmp=$(mktemp)
      cat > "$fu_tmp"
      fu_b64=""
      fu_mime=""
    else
      echo "Error: file= parameter or stdin required" >&2; exit 1
    fi

    fu_json=$(mktemp)
    jq -n \
      --rawfile data "$fu_tmp" \
      --arg folder "$fu_folder" \
      --arg name "$fu_name" \
      --arg isBase64 "$fu_b64" \
      --arg mimeType "$fu_mime" \
      '{action: "file:upload", folder: $folder, name: $name, data: $data, isBase64: $isBase64, mimeType: $mimeType}' > "$fu_json"
    rm -f "$fu_tmp"

    response=$(gas_post "$(cat "$fu_json")")
    rm -f "$fu_json"
  else
    json_body=$(jq -n \
      --arg action "file:$file_subaction" \
      --arg id "$fu_id" \
      --arg folder "$fu_folder" \
      --arg name "$fu_name" \
      '{action: $action, id: $id, folder: $folder, name: $name}')

    response=$(gas_post "$json_body")
  fi

        --arg to "$m_to" \
        --arg via "$m_via" \
        --arg mode "$m_mode" \
        '{action: "map:route", from: $from, to: $to, via: $via, mode: $mode}')
      response=$(gas_get "$params_json")
      map_url=$(echo "$response" | jq -r '.url // empty')
      if [[ -z "$map_url" ]]; then
        echo "Error: No URL returned by GAS" >&2
        echo "$response" >&2
        exit 1

#!/usr/bin/env bash
set -euo pipefail

resolve_path() {
  local target="$1"
  while [ -L "$target" ]; do
    local dir="$(cd "$(dirname "$target")" && pwd)"
    target="$(readlink "$target")"
    [[ "$target" != /* ]] && target="$dir/$target"
  done
  echo "$(cd "$(dirname "$target")" && pwd)"
}
SCRIPT_DIR="$(resolve_path "$0")"
source "$SCRIPT_DIR/../.env"

# Use DEV_DEPLOY_ID when on non-main branch inside the repo
ACTIVE_DEPLOY_ID="$DEPLOY_ID"
if [ -n "${DEV_DEPLOY_ID:-}" ]; then
  _branch=$(git -C "$SCRIPT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
  if [ -n "$_branch" ] && [ "$_branch" != "main" ]; then
    ACTIVE_DEPLOY_ID="$DEV_DEPLOY_ID"
  fi
fi

BASE="https://script.google.com/macros/s/${ACTIVE_DEPLOY_ID}/exec"
DAEMON_PORT="${MYG_DAEMON_PORT:-19287}"
DAEMON_URL="http://127.0.0.1:${DAEMON_PORT}"
DAEMON_PID_FILE="$SCRIPT_DIR/../.daemon-pid"
DAEMON_SCRIPT="$SCRIPT_DIR/../daemon/index.js"

show_help() {
  cat "$SCRIPT_DIR/help.txt"
  exit 0
}

open_browser() {
  local url="$1"
  if command -v open &>/dev/null; then
    open "$url"
  elif command -v wslview &>/dev/null; then
    wslview "$url"
  elif command -v xdg-open &>/dev/null; then
    xdg-open "$url"
  else
    echo "Open this URL in your browser:" >&2
    echo "$url" >&2
  fi
}

daemon_is_running() {
  curl -s -o /dev/null -w "%{http_code}" "$DAEMON_URL/status" 2>/dev/null | grep -q "200"
}

daemon_start() {
  if daemon_is_running; then
    return 0
  fi
  MYG_DAEMON_PORT="$DAEMON_PORT" ${NODE_EXTRA_CA_CERTS:+NODE_EXTRA_CA_CERTS="$NODE_EXTRA_CA_CERTS"} nohup node "$DAEMON_SCRIPT" >/dev/null 2>&1 &
  # Wait for daemon to be ready
  local retries=0
  while ! daemon_is_running; do
    retries=$((retries + 1))
    if [[ $retries -gt 20 ]]; then
      echo "Error: Failed to start myg daemon." >&2
      exit 1
    fi
    sleep 0.1
  done
}

daemon_has_token() {
  local status
  status=$(curl -s "$DAEMON_URL/status" 2>/dev/null)
  echo "$status" | grep -q '"hasToken":true'
}

action="${1:---help}"
shift 2>/dev/null || true

if [[ "$action" == "--help" || "$action" == "-h" || "$action" == "help" ]]; then
  show_help
fi

if [[ "$action" == "auth" ]]; then
  # Auto-update check (only on main branch)
  repo_dir="$(cd "$SCRIPT_DIR/.." && pwd)"
  if git -C "$repo_dir" rev-parse --is-inside-work-tree &>/dev/null; then
    _current_branch=$(git -C "$repo_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    if [[ "$_current_branch" == "main" ]]; then
      old_rev=$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null)
      git -C "$repo_dir" fetch --quiet 2>/dev/null
      new_rev=$(git -C "$repo_dir" rev-parse origin/main 2>/dev/null)
      if [[ -n "$old_rev" && -n "$new_rev" && "$old_rev" != "$new_rev" ]]; then
        git -C "$repo_dir" reset --hard origin/main --quiet 2>/dev/null
        count=$(git -C "$repo_dir" rev-list "$old_rev..$new_rev" --count 2>/dev/null || echo "?")
        echo "Updated myg ($count new commit(s)):" >&2
        git -C "$repo_dir" log --oneline "$old_rev..$new_rev" 2>/dev/null | sed 's/^/  - /' >&2
        echo "" >&2
      fi
    fi
  fi

  # Start daemon (lazy start)
  daemon_start
  echo "Daemon started (port $DAEMON_PORT)." >&2

  # Open auth URL with callback port
  if [[ -n "${GW_DOMAIN:-}" ]]; then
    auth_url="https://script.google.com/a/macros/$GW_DOMAIN/s/$DEPLOY_ID/exec?action=auth&port=$DAEMON_PORT"
  else
    auth_url="${BASE}?action=auth&port=$DAEMON_PORT"
  fi

  echo "Opening browser for authentication..." >&2
  open_browser "$auth_url"

  # Wait for token to arrive via callback
  echo "Waiting for authentication..." >&2
  retries=0
  while ! daemon_has_token; do
    retries=$((retries + 1))
    if [[ $retries -gt 1200 ]]; then
      echo "" >&2
      echo "Timeout: No token received within 120 seconds." >&2
      echo "You can also set the token manually: myg token <TOKEN>" >&2
      exit 1
    fi
    sleep 0.1
  done

  echo "Authentication complete." >&2
  exit 0
fi

if [[ "$action" == "daemon" ]]; then
  subcmd="${1:-status}"
  shift 2>/dev/null || true
  case "$subcmd" in
    start)
      daemon_start
      echo "Daemon running (port $DAEMON_PORT, pid $(cat "$DAEMON_PID_FILE" 2>/dev/null || echo '?'))." >&2
      ;;
    stop)
      if daemon_is_running; then
        curl -s -X POST "$DAEMON_URL/shutdown" >/dev/null
        echo "Daemon stopped." >&2
      else
        echo "Daemon is not running." >&2
      fi
      ;;
    status)
      if daemon_is_running; then
        curl -s "$DAEMON_URL/status" | jq .
      else
        echo "Daemon is not running." >&2
        exit 1
      fi
      ;;
    *)
      echo "Usage: myg daemon [start|stop|status]" >&2
      exit 1
      ;;
  esac
  exit 0
fi

# --- ACL management (local, no token required) ---
if [[ "$action" == "acl" ]]; then
  PERM_FILE="$SCRIPT_DIR/../.permission.json"
  acl_target="${1:-}"
  shift 2>/dev/null || true

  # Ensure .permission.json exists
  if [[ ! -f "$PERM_FILE" ]]; then
    echo '{}' > "$PERM_FILE"
    chmod 444 "$PERM_FILE"
  fi

  perm_write() {
    local content="$1"
    chmod 644 "$PERM_FILE" 2>/dev/null || true
    echo "$content" > "$PERM_FILE"
    chmod 444 "$PERM_FILE"
  }

  if [[ "$acl_target" == "command" ]]; then
    acl_verb="${1:-}"
    shift 2>/dev/null || true
    acl_value="$*"

    case "$acl_verb" in
      "")
        # Show current settings
        echo "Current .permission.json:" >&2
        jq '.' "$PERM_FILE"
        ;;
      deny)
        if [[ -z "$acl_value" ]]; then
          echo "Usage: myg acl command deny \"<command>\"" >&2; exit 1
        fi
        # Check for allow/deny conflict
        if jq -e '.allow' "$PERM_FILE" &>/dev/null; then
          echo "Error: Cannot add deny rule when allow list exists. Use 'myg acl command reset' first." >&2; exit 1
        fi
        new=$(jq --arg v "$acl_value" '.deny = ((.deny // []) | if index($v) then . else . + [$v] end)' "$PERM_FILE")
        perm_write "$new"
        echo "Denied: $acl_value" >&2
        ;;
      allow)
        if [[ -z "$acl_value" ]]; then
          echo "Usage: myg acl command allow \"<command>\"" >&2; exit 1
        fi
        # Check for allow/deny conflict
        if jq -e '.deny' "$PERM_FILE" &>/dev/null; then
          echo "Error: Cannot add allow rule when deny list exists. Use 'myg acl command reset' first." >&2; exit 1
        fi
        new=$(jq --arg v "$acl_value" '.allow = ((.allow // []) | if index($v) then . else . + [$v] end)' "$PERM_FILE")
        perm_write "$new"
        echo "Allowed: $acl_value" >&2
        ;;
      remove)
        if [[ -z "$acl_value" ]]; then
          echo "Usage: myg acl command remove \"<command>\"" >&2; exit 1
        fi
        if [[ ! -t 0 ]]; then
          echo "Error: ACL change (remove) requires interactive terminal" >&2; exit 1
        fi
        echo "This will remove '$acl_value' from the restriction list."
        printf "Proceed? [y/N]: "
        read -r confirm
        if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
          echo "Cancelled." >&2; exit 0
        fi
        new=$(jq --arg v "$acl_value" '
          if .deny then .deny = (.deny | map(select(. != $v)) | if length == 0 then empty else . end) else . end |
          if .allow then .allow = (.allow | map(select(. != $v)) | if length == 0 then empty else . end) else . end |
          if .deny == null then del(.deny) else . end |
          if .allow == null then del(.allow) else . end
        ' "$PERM_FILE")
        perm_write "$new"
        echo "Removed: $acl_value" >&2
        ;;
      reset)
        if [[ ! -t 0 ]]; then
          echo "Error: ACL change (reset) requires interactive terminal" >&2; exit 1
        fi
        echo "WARNING: This will clear ALL permission restrictions."
        printf "Proceed? [y/N]: "
        read -r confirm
        if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
          echo "Cancelled." >&2; exit 0
        fi
        perm_write '{}'
        echo "All restrictions cleared." >&2
        ;;
      *)
        echo "Unknown acl command verb: $acl_verb" >&2
        echo "Usage: myg acl command [deny|allow|remove|reset] [\"<command>\"]" >&2
        exit 1
        ;;
    esac
  elif [[ "$acl_target" == "file" ]]; then
    acl_file_id=""
    acl_file_verb=""
    for arg in "$@"; do
      case "$arg" in
        id=*) acl_file_id="${arg#id=}" ;;
        deny|readonly|full) acl_file_verb="$arg" ;;
      esac
    done

    if [[ -z "$acl_file_id" ]]; then
      echo "Usage: myg acl file id=<FILE_ID> [deny|readonly|full]" >&2; exit 1
    fi

    # ACL file operations require daemon
    if ! daemon_is_running || ! daemon_has_token; then
      echo "No credentials. Run: myg auth" >&2; exit 1
    fi

    acl_file_set_props() {
      local value="$1"
      local body
      body=$(jq -n --arg action "file:props:set" --arg id "$acl_file_id" --arg value "$value" \
        '{action: $action, id: $id, value: $value}')
      curl -s -X POST "$DAEMON_URL/proxy" \
        -H "Content-Type: application/json" \
        -d "$(jq -n --arg url "$BASE" --argjson postBody "$body" '{gasUrl: $url, method: "POST", postBody: $postBody}')"
    }

    acl_file_confirm() {
      local msg="$1"
      if [[ ! -t 0 ]]; then
        echo "Error: ACL change requires interactive terminal (stdin must be a TTY)" >&2; exit 1
      fi
      echo "$msg"
      printf "Proceed? [y/N]: "
      read -r confirm
      if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
        echo "Cancelled." >&2; exit 0
      fi
    }

    case "$acl_file_verb" in
      "")
        local params_json
        params_json=$(jq -n '{action: "file:props", id: $id}' --arg id "$acl_file_id")
        curl -s -X POST "$DAEMON_URL/proxy" \
          -H "Content-Type: application/json" \
          -d "$(jq -n --arg url "$BASE" --argjson params "$params_json" '{gasUrl: $url, method: "GET", params: $params}')"
        ;;
      deny)
        acl_file_confirm "WARNING: This will DENY all myg access (read & write) to this file."
        acl_file_set_props "-"
        ;;
      readonly)
        acl_file_confirm "This will set the file to READ-ONLY via myg."
        acl_file_set_props "r"
        ;;
      full)
        acl_file_confirm "This will set the file to READ+WRITE via myg."
        acl_file_set_props "w"
        ;;
      *)
        echo "Unknown verb: $acl_file_verb" >&2
        echo "Usage: myg acl file id=<FILE_ID> [deny|readonly|full]" >&2
        exit 1
        ;;
    esac
  else
    echo "Usage: myg acl command [deny|allow|remove|reset] [\"<command>\"]" >&2
    echo "       myg acl file id=<FILE_ID> [deny|readonly|full]" >&2
    exit 1
  fi
  exit 0
fi

if ! daemon_is_running || ! daemon_has_token; then
  echo "No credentials. Run: myg auth" >&2
  exit 1
fi

# --- Request helpers (all requests proxied through daemon) ---
gas_get() {
  local params=("$@")
  local params_json
  params_json=$(printf '%s\n' "${params[@]}" | jq -R 'split("=") | {(.[0]): .[1:] | join("=")}' | jq -s 'add')
  curl -s -X POST "$DAEMON_URL/proxy" \
    -H "Content-Type: application/json" \
    -d "$(jq -n --arg url "$BASE" --argjson params "$params_json" '{gasUrl: $url, method: "GET", params: $params}')"
}

gas_post() {
  local body="$1"
  local post_body
  post_body=$(echo "$body" | jq '.')
  curl -s -X POST "$DAEMON_URL/proxy" \
    -H "Content-Type: application/json" \
    -d "$(jq -n --arg url "$BASE" --argjson postBody "$post_body" '{gasUrl: $url, method: "POST", postBody: $postBody}')"
}

# Permission check via .permission.json
check_permission() {
  local full_action="$1"
  local config="$SCRIPT_DIR/../.permission.json"
  [[ ! -f "$config" ]] && return 0

  if jq -e '.allow' "$config" &>/dev/null; then
    if ! jq -e --arg a "$full_action" '.allow | index($a)' "$config" &>/dev/null; then
      echo "Action '$full_action' is not in allow list. Check .permission.json" >&2
      exit 1
    fi
  fi

  if jq -e '.deny' "$config" &>/dev/null; then
    if jq -e --arg a "$full_action" '.deny | index($a)' "$config" &>/dev/null; then
      echo "Action '$full_action' is denied. Check .permission.json" >&2
      exit 1
    fi
  fi
}

# doc subcommands (create/append/overwrite) use POST + stdin
doc_subaction=""
if [[ "$action" == "doc" && $# -gt 0 ]]; then
  case "$1" in
    create|append|overwrite|addtab|renametab|movetab|copytab) doc_subaction="$1"; shift ;;
    tabs) doc_subaction="tabs"; shift ;;
  esac
fi

# mail subcommands (draft) use POST
mail_subaction=""
if [[ "$action" == "mail" && $# -gt 0 ]]; then
  case "$1" in
    draft) mail_subaction="$1"; shift
           if [[ $# -gt 0 && "$1" == "delete" ]]; then
             mail_subaction="draft:delete"; shift
           fi ;;
    filters) mail_subaction="filters" ; shift ;;
    labels)  mail_subaction="labels" ; shift ;;
    filter)  shift
             case "$1" in
               create|delete) mail_subaction="filter:$1"; shift ;;
             esac ;;
    label)   mail_subaction="label"; shift ;;

  esac
fi

# sheet write subcommand uses POST + stdin (TSV)
sheet_write=""
sheet_create=""
sheet_delete=""
sheet_rename=""
sheet_lastrow=""
sheet_notes=""
sheet_note_set=""
sheet_note_clear=""
sheet_color=""
spreadsheet_create=""
if [[ "$action" == "sheet" && $# -gt 0 ]]; then
  case "$1" in
    write)      sheet_write="1"; shift ;;
    create)     sheet_create="1"; shift ;;
    delete)     sheet_delete="1"; shift ;;
    rename)     sheet_rename="1"; shift ;;
    lastrow)    sheet_lastrow="1"; shift ;;
    notes)      sheet_notes="1"; shift ;;
    color)      sheet_color="1"; shift ;;
    note)
      shift
      case "$1" in
        set)   sheet_note_set="1"; shift ;;
        clear) sheet_note_clear="1"; shift ;;
      esac
      ;;
  esac
fi
if [[ "$action" == "spreadsheet" && $# -gt 0 ]]; then
  case "$1" in
    create) spreadsheet_create="1"; shift ;;
  esac
fi

# task subcommands (create/done) use POST
task_subaction=""
if [[ "$action" == "task" && $# -gt 0 ]]; then
  case "$1" in
    create|done|update|delete) task_subaction="$1"; shift ;;
  esac
fi

# tasklist subcommands use POST
tasklist_subaction=""
if [[ "$action" == "tasklist" && $# -gt 0 ]]; then
  case "$1" in
    create|update|delete) tasklist_subaction="$1"; shift ;;
  esac
fi

# file subcommands (upload/move) use POST
file_subaction=""
if [[ "$action" == "file" && $# -gt 0 ]]; then
  case "$1" in
    upload|move|copy|history|diff|rename|shortcut|mkdir|share|unshare) file_subaction="$1"; shift ;;
  esac
fi

# slide subcommands (create/addpage/addtext) use POST
slide_subaction=""
slide_notes=""
slide_note_set=""
slide_note_clear=""
if [[ "$action" == "slide" && $# -gt 0 ]]; then
  case "$1" in
    create|addpage|addtext|overwrite) slide_subaction="$1"; shift ;;
    notes) slide_notes="1"; shift ;;
    note)
      shift
      case "$1" in
        set)   slide_note_set="1"; shift ;;
        clear) slide_note_clear="1"; shift ;;
      esac
      ;;
  esac
fi

# form subcommands use POST or special GET
form_subaction=""
if [[ "$action" == "form" && $# -gt 0 ]]; then
  case "$1" in
    create|additem) form_subaction="$1"; shift ;;
    responses)      form_subaction="responses"; shift ;;
  esac
fi

# contacts subcommands
contacts_subaction=""
if [[ "$action" == "contacts" && $# -gt 0 ]]; then
  case "$1" in
    search) contacts_subaction="search"; shift ;;
  esac
fi

# comment subcommands
comment_subaction=""
if [[ "$action" == "comment" && $# -gt 0 ]]; then
  case "$1" in
    create|update|delete) comment_subaction="$1"; shift ;;
  esac
fi

# files subcommands
files_subaction=""
if [[ "$action" == "files" && $# -gt 0 ]]; then
  case "$1" in
    search) files_subaction="search"; shift ;;
  esac
fi

# tasks subcommands
tasks_subaction=""
if [[ "$action" == "tasks" && $# -gt 0 ]]; then
  case "$1" in
    completed) tasks_subaction="completed"; shift ;;
  esac
fi

# event subcommands (create) use POST
event_subaction=""
if [[ "$action" == "event" && $# -gt 0 ]]; then
  case "$1" in
    create|freebusy|update|delete|rooms) event_subaction="$1"; shift ;;
  esac
fi

# gas subcommands use GET
gas_subaction=""
if [[ "$action" == "gas" && $# -gt 0 ]]; then
  case "$1" in
    info|list|files|file) gas_subaction="$1"; shift ;;
  esac
fi

# Resolve full action name for permission check (normalize : to space for user-facing format)
full_action="$action"
[[ -n "${doc_subaction:-}" ]] && full_action="doc $doc_subaction"
[[ -n "${mail_subaction:-}" ]] && full_action="mail ${mail_subaction//:/ }"
[[ -n "${sheet_write:-}" ]] && full_action="sheet write"
[[ -n "${sheet_create:-}" ]] && full_action="sheet create"
[[ -n "${sheet_delete:-}" ]] && full_action="sheet delete"
[[ -n "${sheet_rename:-}" ]] && full_action="sheet rename"
[[ -n "${sheet_color:-}" ]] && full_action="sheet color"
[[ -n "${spreadsheet_create:-}" ]] && full_action="spreadsheet create"
[[ -n "${task_subaction:-}" ]] && full_action="task $task_subaction"
[[ -n "${tasklist_subaction:-}" ]] && full_action="tasklist $tasklist_subaction"
[[ -n "${file_subaction:-}" ]] && full_action="file $file_subaction"
[[ -n "${slide_subaction:-}" ]] && full_action="slide $slide_subaction"
[[ -n "${form_subaction:-}" ]] && full_action="form $form_subaction"
[[ -n "${contacts_subaction:-}" ]] && full_action="contacts $contacts_subaction"
[[ -n "${files_subaction:-}" ]] && full_action="files $files_subaction"
[[ -n "${tasks_subaction:-}" ]] && full_action="tasks $tasks_subaction"
[[ -n "${event_subaction:-}" ]] && full_action="event $event_subaction"
[[ -n "${gas_subaction:-}" ]] && full_action="gas $gas_subaction"
check_permission "$full_action"

if [[ -n "$gas_subaction" ]]; then
  g_script=""
  g_name=""
  g_max=""
  for arg in "$@"; do
    case "$arg" in
      script=*) g_script="${arg#script=}" ;;
      name=*)   g_name="${arg#name=}" ;;
      max=*)    g_max="${arg#max=}" ;;
    esac
  done
  local_params=("action=gas:${gas_subaction}")

  [[ -n "$g_script" ]] && local_params+=("script=${g_script}")

  [[ -n "$g_name" ]] && local_params+=("name=${g_name}")

  [[ -n "$g_max" ]] && local_params+=("max=${g_max}")

  response=$(gas_get "${local_params[@]}")
elif [[ -n "$tasks_subaction" ]]; then
  tc_id=""
  for arg in "$@"; do
    case "$arg" in
      id=*) tc_id="${arg#id=}" ;;
    esac
  done
  response=$(gas_get "action=tasks:completed" "id=${tc_id}")
elif [[ -n "$files_subaction" ]]; then
  fs_q=""
  fs_max=""
  for arg in "$@"; do
    case "$arg" in
      q=*)   fs_q="${arg#q=}" ;;
      max=*) fs_max="${arg#max=}" ;;
    esac
  done
  response=$(gas_get "action=files:search" "q=${fs_q}" "max=${fs_max:-20}")
elif [[ -n "$contacts_subaction" ]]; then
  c_q=""
  c_max=""
  for arg in "$@"; do
    case "$arg" in
      q=*)   c_q="${arg#q=}" ;;
      max=*) c_max="${arg#max=}" ;;
    esac
  done
  response=$(gas_get "action=contacts:search" "q=${c_q}" "max=${c_max:-20}")
elif [[ -n "$form_subaction" ]]; then
  fm_id=""
  fm_name=""
  fm_desc=""
  fm_type=""
  fm_title=""
  fm_choices=""
  fm_required=""
  fm_low=""
  fm_high=""
  fm_lowLabel=""
  fm_highLabel=""
  for arg in "$@"; do
    case "$arg" in
      id=*)        fm_id="${arg#id=}" ;;
      name=*)      fm_name="${arg#name=}" ;;
      description=*) fm_desc="${arg#description=}" ;;
      type=*)      fm_type="${arg#type=}" ;;
      title=*)     fm_title="${arg#title=}" ;;
      choices=*)   fm_choices="${arg#choices=}" ;;
      required)    fm_required="true" ;;
      low=*)       fm_low="${arg#low=}" ;;
      high=*)      fm_high="${arg#high=}" ;;
      lowLabel=*)  fm_lowLabel="${arg#lowLabel=}" ;;
      highLabel=*) fm_highLabel="${arg#highLabel=}" ;;
    esac
  done

  if [[ "$form_subaction" == "responses" ]]; then
    response=$(gas_get "action=form:responses" "id=${fm_id}")
  else
    json_body=$(jq -n \
      --arg sub "$form_subaction" \
      --arg id "$fm_id" \
      --arg name "$fm_name" \
      --arg description "$fm_desc" \
      --arg type "$fm_type" \
      --arg title "$fm_title" \
      --arg choices "$fm_choices" \
      --arg required "$fm_required" \
      --arg low "$fm_low" \
      --arg high "$fm_high" \
      --arg lowLabel "$fm_lowLabel" \
      --arg highLabel "$fm_highLabel" \
      '{action: ("form:" + $sub), id: $id, name: $name, description: $description, type: $type, title: $title, choices: $choices, required: $required, low: $low, high: $high, lowLabel: $lowLabel, highLabel: $highLabel}')

    response=$(gas_post "$json_body")
  fi
elif [[ -n "$comment_subaction" ]]; then
  cm_id=""
  cm_comment=""
  for arg in "$@"; do
    case "$arg" in
      id=*) cm_id="${arg#id=}" ;;
      comment=*) cm_comment="${arg#comment=}" ;;
    esac
  done

  if [[ "$comment_subaction" == "delete" ]]; then
    json_body=$(jq -n \
      --arg id "$cm_id" \
      --arg comment "$cm_comment" \
      '{action: "comment:delete", id: $id, comment: $comment}')
  else
    stdin_text=""
    if [[ ! -t 0 ]]; then
      stdin_text=$(cat)
    fi
    if [[ -z "$stdin_text" ]]; then
      echo "Error: No comment text provided via stdin" >&2
      exit 1
    fi

    json_body=$(jq -n \
      --arg sub "$comment_subaction" \
      --arg id "$cm_id" \

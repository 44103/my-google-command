#!/usr/bin/env bash
set -euo pipefail

resolve_path() {
  local target="$1"
  while [ -L "$target" ]; do
    local dir="$(cd "$(dirname "$target")" && pwd)"
    target="$(readlink "$target")"
    [[ "$target" != /* ]] && target="$dir/$target"
  done
  echo "$(cd "$(dirname "$target")" && pwd)"
}
SCRIPT_DIR="$(resolve_path "$0")"
source "$SCRIPT_DIR/../.env"

# Use DEV_DEPLOY_ID when on non-main branch inside the repo
ACTIVE_DEPLOY_ID="$DEPLOY_ID"
if [ -n "${DEV_DEPLOY_ID:-}" ]; then
  _branch=$(git -C "$SCRIPT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
  if [ -n "$_branch" ] && [ "$_branch" != "main" ]; then
    ACTIVE_DEPLOY_ID="$DEV_DEPLOY_ID"
  fi
fi

TOKEN_FILE="$SCRIPT_DIR/../.token"
BASE="https://script.google.com/macros/s/${ACTIVE_DEPLOY_ID}/exec"

# --- Daemon configuration ---
DAEMON_SCRIPT="$SCRIPT_DIR/../daemon/index.js"
DAEMON_PORT="${MYG_DAEMON_PORT:-19333}"
DAEMON_HOST="127.0.0.1"
DAEMON_URL="http://${DAEMON_HOST}:${DAEMON_PORT}"
DAEMON_PID_FILE="$SCRIPT_DIR/../.daemon-pid"
DAEMON_LOG="/tmp/myg-daemon.log"

# --- Daemon helper functions ---
daemon_check_node() {
  if ! command -v node &>/dev/null; then
    echo "Error: Node.js is required but not found in PATH." >&2
    echo "Install Node.js 18+ from https://nodejs.org/" >&2
    exit 1
  fi
  local node_major
  node_major=$(node -v | sed 's/v//' | cut -d. -f1)
  if [[ $node_major -lt 18 ]]; then
    echo "Error: Node.js 18+ required (found: $(node -v))" >&2
    echo "Install Node.js 18+ from https://nodejs.org/" >&2
    exit 1
  fi
}

daemon_is_running() {
  curl -s --max-time 1 "${DAEMON_URL}/status" >/dev/null 2>&1
}

daemon_start() {
  if daemon_is_running; then
    return 0
  fi

  daemon_check_node

  # Check port availability
  if command -v lsof &>/dev/null; then
    if lsof -i ":${DAEMON_PORT}" -sTCP:LISTEN >/dev/null 2>&1; then
      echo "Error: Port ${DAEMON_PORT} is already in use." >&2
      echo "Check with: lsof -i :${DAEMON_PORT}" >&2
      exit 1
    fi
  fi

  # Clear previous log
  : > "$DAEMON_LOG" 2>/dev/null || true

  # Start daemon with stderr to /dev/null (daemon writes its own log file)
  nohup node "$DAEMON_SCRIPT" >/dev/null 2>&1 &
  local daemon_pid=$!

  # Wait for daemon to become ready (exponential backoff, max ~5s)
  local wait_ms=100
  local total_ms=0
  local max_ms=5000
  while [[ $total_ms -lt $max_ms ]]; do
    sleep "$(echo "scale=3; $wait_ms/1000" | bc)"
    total_ms=$((total_ms + wait_ms))
    if daemon_is_running; then
      return 0
    fi
    # Check if process died
    if ! kill -0 "$daemon_pid" 2>/dev/null; then
      echo "Error: Failed to start myg daemon." >&2
      echo "" >&2
      if [[ -f "$DAEMON_LOG" && -s "$DAEMON_LOG" ]]; then
        echo "--- Daemon log ---" >&2
        cat "$DAEMON_LOG" >&2
        echo "--- End log ---" >&2
      else
        echo "No log output available. Check that Node.js is working correctly." >&2
      fi
      exit 1
    fi
    # Exponential backoff: 100, 200, 400, 800, 1000 (cap at 1s)
    wait_ms=$((wait_ms * 2))
    [[ $wait_ms -gt 1000 ]] && wait_ms=1000
  done

  # Timeout reached
  echo "Error: Daemon did not respond within ${max_ms}ms." >&2
  if [[ -f "$DAEMON_LOG" && -s "$DAEMON_LOG" ]]; then
    echo "" >&2
    echo "--- Daemon log ---" >&2
    cat "$DAEMON_LOG" >&2
    echo "--- End log ---" >&2
  fi
  exit 1
}

daemon_stop() {
  if daemon_is_running; then
    curl -s --max-time 3 -X POST "${DAEMON_URL}/shutdown" >/dev/null 2>&1 || true
    sleep 0.5
  fi
  # Fallback: kill by PID file
  if [[ -f "$DAEMON_PID_FILE" ]]; then
    local pid
    pid=$(cat "$DAEMON_PID_FILE" 2>/dev/null)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
    rm -f "$DAEMON_PID_FILE"
  fi
}

daemon_status() {
  if daemon_is_running; then
    curl -s "${DAEMON_URL}/status" | jq .
  else
    echo "Daemon is not running." >&2
    exit 1
  fi
}

# --- GAS API call functions ---
# Prefer daemon proxy, fallback to direct curl if daemon unavailable
# Usage: gas_get '{"action":"xxx", "id":"yyy"}'
# Usage: gas_post '{"action":"xxx", "data":"yyy"}'

gas_get() {
  local params="$1"
  # Try daemon proxy first
  if daemon_is_running; then
    local json_body
    json_body=$(jq -n --arg url "$BASE" --argjson params "$params" \
      '{gasUrl: $url, method: "GET", params: $params}')
    local resp
    resp=$(curl -s -X POST "${DAEMON_URL}/proxy" \
      -H "Content-Type: application/json" \
      -d "$json_body")
    # Check for daemon auth error
    if echo "$resp" | jq -e '.error == "No token. Run: myg auth"' >/dev/null 2>&1; then
      echo "$resp"
      return 1
    fi
    echo "$resp"
    return 0
  fi
  # Fallback to direct curl
  if [[ -z "${ACCESS_TOKEN:-}" ]]; then
    echo '{"error":"No token. Run: myg auth"}'
    return 1
  fi
  local url="$BASE"
  local qs
  qs=$(echo "$params" | jq -r 'to_entries | map("\(.key)=\(.value | @uri)") | join("&")')
  curl -s -L -H "Authorization: Bearer ${ACCESS_TOKEN}" -G "${url}?${qs}"
}

gas_post() {
  local post_body="$1"
  # Try daemon proxy first
  if daemon_is_running; then
    local json_body
    json_body=$(jq -n --arg url "$BASE" --argjson body "$post_body" \
      '{gasUrl: $url, method: "POST", postBody: $body}')
    local resp
    resp=$(curl -s -X POST "${DAEMON_URL}/proxy" \
      -H "Content-Type: application/json" \
      -d "$json_body")
    # Check for daemon auth error
    if echo "$resp" | jq -e '.error == "No token. Run: myg auth"' >/dev/null 2>&1; then
      echo "$resp"
      return 1
    fi
    echo "$resp"
    return 0
  fi
  # Fallback to direct curl
  if [[ -z "${ACCESS_TOKEN:-}" ]]; then
    echo '{"error":"No token. Run: myg auth"}'
    return 1
  fi
  curl -s -L -H "Authorization: Bearer ${ACCESS_TOKEN}" \
    -H "Content-Type: application/json" \
    -d "$post_body" "$BASE"
}

# --- Utility: encode a shell variable as a JSON string ---
# Uses jq --arg so no trailing-newline issue (unlike echo | jq -Rs).
# Usage: to_json_string "$value"  → "\"escaped value\""
to_json_string() {
  jq -n --arg v "$1" '$v'
}

# --- Common confirmation function ---
# Usage: require_confirm "message" ["action_label"] ["aclMessage"]
# TTY: interactive y/N prompt
# No TTY + daemon: browser confirmation via long-poll
# No TTY + no daemon: error
require_confirm() {
  local msg="$1"
  local action_label="${2:-}"
  local acl_message="${3:-}"
  # TTY available: use interactive prompt
  if [[ -t 0 ]]; then
    echo "$msg"
    if [[ -n "$acl_message" ]]; then
      # Convert [text](url) to "text (url)" for terminal display
      local display_msg
      display_msg=$(echo "$acl_message" | sed -E 's/\[([^]]+)\]\(([^)]+)\)/\1 (\2)/g')
      echo -e "\033[1;33m$display_msg\033[0m"
    fi
    printf "Proceed? [y/N]: "
    read -r confirm
    if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
      echo "Cancelled." >&2; exit 0
    fi
    return
  fi
  # No TTY: use daemon browser confirmation
  if ! daemon_is_running; then
    daemon_start 2>/dev/null || true
  fi
  if daemon_is_running; then
    local _confirm_resp _confirm_id _confirm_url _confirm_result
    _confirm_resp=$(curl -s -X POST "${DAEMON_URL}/confirm/request" \
      -H "Content-Type: application/json" \
      -d "$(jq -n --arg message "$msg" --arg action "$action_label" --arg aclMessage "$acl_message" '{message: $message, action: $action, aclMessage: $aclMessage}')")
    _confirm_id=$(echo "$_confirm_resp" | jq -r '.id // empty')
    _confirm_url=$(echo "$_confirm_resp" | jq -r '.url // empty')
    if [[ -z "$_confirm_id" ]]; then
      echo "Error: Failed to create confirmation request." >&2; exit 1
    fi
    echo "$msg" >&2
    echo "" >&2
    echo "Approve in browser: $_confirm_url" >&2
    open_browser "$_confirm_url" 2>/dev/null || true
    echo "Waiting for confirmation (60s timeout)..." >&2
    _confirm_result=$(curl -s --max-time 65 "${DAEMON_URL}/confirm/${_confirm_id}/wait" | jq -r '.status // "timeout"')
    if [[ "$_confirm_result" == "approved" ]]; then
      echo "Approved." >&2
      return
    elif [[ "$_confirm_result" == "denied" ]]; then
      echo "Denied." >&2; exit 0
    else
      echo "Timed out waiting for confirmation." >&2; exit 1
    fi
  else
    echo "Error: This operation requires interactive terminal or running daemon." >&2
    echo "Start daemon with: myg daemon start" >&2
    exit 1
  fi
}

show_help() {
  cat "$SCRIPT_DIR/help.txt"
  exit 0
}

open_browser() {
  local url="$1"
  if command -v open &>/dev/null; then
    open "$url"
  elif command -v wslview &>/dev/null; then
    wslview "$url"
  elif command -v xdg-open &>/dev/null; then
    xdg-open "$url"
  else
    echo "Open this URL in your browser:" >&2
    echo "$url" >&2
  fi
}

action="${1:---help}"
shift 2>/dev/null || true

if [[ "$action" == "--help" || "$action" == "-h" || "$action" == "help" ]]; then
  show_help
fi

# --- daemon subcommand ---
if [[ "$action" == "daemon" ]]; then
  daemon_verb="${1:-status}"
  shift 2>/dev/null || true
  case "$daemon_verb" in
    start)  daemon_start; echo "Daemon is running." >&2 ;;
    stop)   daemon_stop; echo "Daemon stopped." >&2 ;;
    status) daemon_status ;;
    *)
      echo "Usage: myg daemon [start|stop|status]" >&2
      exit 1
      ;;
  esac
  exit 0
fi

if [[ "$action" == "feedback" ]]; then
  result=$(gas_get '{"action":"feedback"}') || { echo "Failed to reach daemon. Is it running?" >&2; exit 1; }
  url=$(echo "$result" | jq -r '.url // empty')
  if [[ -z "$url" ]]; then
    echo "Feedback is not configured." >&2
    exit 1
  fi
  echo "$url"
  open_browser "$url"
  exit 0
fi

if [[ "$action" == "auth" ]]; then
  # Auto-update check (only on main branch)
  repo_dir="$(cd "$SCRIPT_DIR/.." && pwd)"
  if git -C "$repo_dir" rev-parse --is-inside-work-tree &>/dev/null; then
    _current_branch=$(git -C "$repo_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    if [[ "$_current_branch" == "main" ]]; then
      old_rev=$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null)
      git -C "$repo_dir" fetch --quiet 2>/dev/null
      new_rev=$(git -C "$repo_dir" rev-parse origin/main 2>/dev/null)
      if [[ -n "$old_rev" && -n "$new_rev" && "$old_rev" != "$new_rev" ]]; then
        git -C "$repo_dir" reset --hard origin/main --quiet 2>/dev/null
        count=$(git -C "$repo_dir" rev-list "$old_rev..$new_rev" --count 2>/dev/null || echo "?")
        echo "Updated myg ($count new commit(s)):" >&2
        git -C "$repo_dir" log --oneline "$old_rev..$new_rev" 2>/dev/null | sed 's/^/  - /' >&2
        echo "" >&2
      fi
    fi
  fi

  # Try daemon-based auth (no copy-paste needed)
  _daemon_auth=false
  if daemon_is_running || (daemon_check_node 2>/dev/null && daemon_start 2>/dev/null); then
    _daemon_auth=true
  fi

  if [[ "$_daemon_auth" == "true" ]]; then
    # Clear any existing token before starting new auth flow
    curl -s -X POST "${DAEMON_URL}/auth/clear" >/dev/null 2>&1 || true

    # Daemon auth: browser sends token directly to daemon callback
    _callback_raw="http://${DAEMON_HOST}:${DAEMON_PORT}/auth/callback"
    _callback_b64=$(echo -n "$_callback_raw" | base64 | tr -d '\n')
    if [[ -n "${GW_DOMAIN:-}" ]]; then
      auth_url="https://script.google.com/a/macros/$GW_DOMAIN/s/$DEPLOY_ID/exec?action=auth&callback=${_callback_b64}"
    else
      auth_url="${BASE}?action=auth&callback=${_callback_b64}"
    fi
    echo "Opening browser for authentication..." >&2
    open_browser "$auth_url"

    echo "Waiting for authentication in browser..." >&2
    _timeout=15
    _elapsed=0
    while [[ $_elapsed -lt $_timeout ]]; do
      sleep 1
      _elapsed=$((_elapsed + 1))
      _has_token=$(curl -s "${DAEMON_URL}/status" | jq -r '.hasToken' 2>/dev/null)
      if [[ "$_has_token" == "true" ]]; then
        # Save token to file for fallback use
        _token_val=$(curl -s "${DAEMON_URL}/token" 2>/dev/null)
        if [[ -n "$_token_val" && "$_token_val" != "null" ]]; then
          echo "$_token_val" > "$TOKEN_FILE"
        fi
        echo "Authentication complete." >&2
        exit 0
      fi
    done
    echo "" >&2
    echo "Timed out. Falling back to manual token entry..." >&2
  fi

  # Fallback: traditional copy-paste auth
  if [[ -n "${GW_DOMAIN:-}" ]]; then
    auth_url="https://script.google.com/a/macros/$GW_DOMAIN/s/$DEPLOY_ID/exec?action=auth"
  else
    auth_url="${BASE}?action=auth"
  fi

  if [[ "$_daemon_auth" == "false" ]]; then
    echo "Opening browser for authentication..." >&2
    open_browser "$auth_url"
  fi

  if [[ ! -t 0 ]]; then
    echo "" >&2
    echo "Non-interactive shell detected. Use 'myg token' instead:" >&2
    echo "  1. Open: $auth_url" >&2
    echo "  2. Copy the token, then run:" >&2
    echo "     myg token <PASTE_TOKEN_HERE>" >&2
    exit 1
  fi

  echo -n "Paste token: " >&2
  read -r token
  if [[ -z "$token" ]]; then
    echo "" >&2
    echo "Empty token. Use 'myg token' for non-interactive environments:" >&2
    echo "  myg token <PASTE_TOKEN_HERE>" >&2
    exit 1
  fi
  echo "$token" > "$TOKEN_FILE"
  echo "Token saved." >&2

  if [[ ! -f "$SCRIPT_DIR/../.permission.json" ]]; then
    echo "" >&2
    echo "Tip: You can create .permission.json to restrict available actions." >&2
    echo "  See: ./scripts/install or README for details" >&2
  fi

  exit 0
fi

if [[ "$action" == "token" ]]; then
  if [[ $# -gt 0 && -n "$1" ]]; then
    echo "$1" > "$TOKEN_FILE"
    # Also send to daemon if running
    if daemon_is_running; then
      curl -s -X POST "${DAEMON_URL}/auth/callback" \
        -H "Content-Type: application/json" \
        -d "{\"token\":\"$1\"}" >/dev/null 2>&1 || true
    fi
    echo "Token saved." >&2
  else
    if [[ -n "${GW_DOMAIN:-}" ]]; then
      auth_url="https://script.google.com/a/macros/$GW_DOMAIN/s/$DEPLOY_ID/exec?action=auth"
    else
      auth_url="${BASE}?action=auth"
    fi
    open_browser "$auth_url"
    echo "$auth_url"
  fi
  exit 0
fi

# --- ACL management (local, no token required) ---
if [[ "$action" == "acl" ]]; then
  PERM_FILE="$SCRIPT_DIR/../.permission.json"
  acl_target="${1:-}"
  shift 2>/dev/null || true

  # Ensure .permission.json exists
  if [[ ! -f "$PERM_FILE" ]]; then
    echo '{}' > "$PERM_FILE"
    chmod 444 "$PERM_FILE"
  fi

  perm_write() {
    local content="$1"
    chmod 644 "$PERM_FILE" 2>/dev/null || true
    echo "$content" > "$PERM_FILE"
    chmod 444 "$PERM_FILE"
  }

  if [[ "$acl_target" == "command" ]]; then
    acl_verb="${1:-}"
    shift 2>/dev/null || true
    acl_value="$*"

    case "$acl_verb" in
      "")
        # Show current settings
        echo "Current .permission.json:" >&2
        jq '.' "$PERM_FILE"
        ;;
      deny)
        if [[ -z "$acl_value" ]]; then
          echo "Usage: myg acl command deny \"<command>\"" >&2; exit 1
        fi
        # Check for allow/deny conflict
        if jq -e '.allow' "$PERM_FILE" &>/dev/null; then
          echo "Error: Cannot add deny rule when allow list exists. Use 'myg acl command reset' first." >&2; exit 1
        fi
        new=$(jq --arg v "$acl_value" '.deny = ((.deny // []) | if index($v) then . else . + [$v] end)' "$PERM_FILE")
        perm_write "$new"
        echo "Denied: $acl_value" >&2
        ;;
      allow)
        if [[ -z "$acl_value" ]]; then
          echo "Usage: myg acl command allow \"<command>\"" >&2; exit 1
        fi
        # Check for allow/deny conflict
        if jq -e '.deny' "$PERM_FILE" &>/dev/null; then
          echo "Error: Cannot add allow rule when deny list exists. Use 'myg acl command reset' first." >&2; exit 1
        fi
        new=$(jq --arg v "$acl_value" '.allow = ((.allow // []) | if index($v) then . else . + [$v] end)' "$PERM_FILE")
        perm_write "$new"
        echo "Allowed: $acl_value" >&2
        ;;
      remove)
        if [[ -z "$acl_value" ]]; then
          echo "Usage: myg acl command remove \"<command>\"" >&2; exit 1
        fi
        require_confirm "This will remove '$acl_value' from the restriction list." "myg acl command remove"
        new=$(jq --arg v "$acl_value" '
          if .deny then .deny = (.deny | map(select(. != $v)) | if length == 0 then empty else . end) else . end |
          if .allow then .allow = (.allow | map(select(. != $v)) | if length == 0 then empty else . end) else . end |
          if .deny == null then del(.deny) else . end |
          if .allow == null then del(.allow) else . end
        ' "$PERM_FILE")
        perm_write "$new"
        echo "Removed: $acl_value" >&2
        ;;
      reset)
        require_confirm "WARNING: This will clear ALL permission restrictions." "myg acl command reset"
        perm_write '{}'
        echo "All restrictions cleared." >&2
        ;;
      *)
        echo "Unknown acl command verb: $acl_verb" >&2
        echo "Usage: myg acl command [deny|allow|remove|reset] [\"<command>\"]" >&2
        exit 1
        ;;
    esac
  elif [[ "$acl_target" == "file" ]]; then
    acl_file_id=""
    acl_file_verb=""
    for arg in "$@"; do
      case "$arg" in
        id=*) acl_file_id="${arg#id=}" ;;
        deny|readonly|full) acl_file_verb="$arg" ;;
      esac
    done

    if [[ -z "$acl_file_id" ]]; then
      echo "Usage: myg acl file id=<FILE_ID> [deny|readonly|full]" >&2; exit 1
    fi

    # Load token for file ACL operations
    if [[ -f "$TOKEN_FILE" ]]; then
      _tk=$(cat "$TOKEN_FILE")
    else
      echo "No credentials. Run: myg auth" >&2; exit 1
    fi

    acl_file_set_props() {
      local value="$1"
      local json_body
      json_body=$(jq -n --arg action "file:props:set" --arg id "$acl_file_id" --arg value "$value" \
        '{action: $action, id: $id, value: $value}')
      curl -s -L -H "Authorization: Bearer ${_tk}" \
        -H "Content-Type: application/json" \
        -d "$json_body" "$BASE"
    }

    acl_file_confirm() {
      local msg="$1"
      local acl_msg="$2"
      local file_url="https://drive.google.com/file/d/${acl_file_id}/view"
      require_confirm "${msg}
File: ${file_url}" "myg acl file id=${acl_file_id}" "$acl_msg"
    }

    acl_file_format_set_response() {
      local resp="$1"
      local name acl storage
      name=$(echo "$resp" | jq -r '.name // "unknown"')
      acl=$(echo "$resp" | jq -r '.acl // "?"')
      storage=$(echo "$resp" | jq -r '.storage // "file"')

      local acl_label
      case "$acl" in
        "-") acl_label="denied (no access)" ;;
        "r") acl_label="readonly" ;;
        "w") acl_label="full (read+write)" ;;
        *)   acl_label="$acl" ;;
      esac

      if [[ "$storage" == "cache" ]]; then
        acl_label="$acl_label (temporary, expires in 10 minutes)"
      else
        acl_label="$acl_label (persistent)"
      fi

      echo "File:  $name" >&2
      echo "ACL:   $acl_label" >&2
    }

    acl_file_format_get_response() {
      local resp="$1"
      local name id acl source
      name=$(echo "$resp" | jq -r '.name // "unknown"')
      id=$(echo "$resp" | jq -r '.id // "?"')
      acl=$(echo "$resp" | jq -r '.properties.acl // empty')
      source=$(echo "$resp" | jq -r '.properties._source // empty')

      echo "File: $name"
      echo "ID:   $id"

      if [[ -z "$acl" ]]; then
        echo "ACL:  (not set)"
      else
        local acl_label
        case "$acl" in
          "-") acl_label="denied (no access)" ;;
          "r") acl_label="readonly" ;;
          "w") acl_label="full (read+write)" ;;
          *)   acl_label="$acl" ;;
        esac
        if [[ "$source" == "cache" ]]; then
          echo "ACL:  $acl_label (temporary)"
        else
          echo "ACL:  $acl_label"
        fi
      fi
    }

    # Get file props (includes aclMessage) - shared across all verbs
    _props=$(curl -s -L -H "Authorization: Bearer ${_tk}" \
      -G --data-urlencode "action=file:props" --data-urlencode "id=${acl_file_id}" "$BASE")
    _err=$(echo "$_props" | jq -r 'if type == "object" then (.error // empty) else empty end' 2>/dev/null)
    if [[ -n "$_err" ]]; then
      echo "Error: $_err" >&2; exit 1
    fi
    _acl_message=$(echo "$_props" | jq -r '.aclMessage // empty' 2>/dev/null)

    case "$acl_file_verb" in
      "")
        acl_file_format_get_response "$_props"
        ;;
      deny)
        acl_file_confirm "WARNING: This will DENY all myg access (read & write) to this file." "$_acl_message"
        _resp=$(acl_file_set_props "-")
        _err=$(echo "$_resp" | jq -r 'if type == "object" then (.error // empty) else empty end' 2>/dev/null)
        if [[ -n "$_err" ]]; then
          echo "Error: $_err" >&2; exit 1
        fi
        acl_file_format_set_response "$_resp"
        ;;
      readonly)
        acl_file_confirm "This will set the file to READ-ONLY via myg." "$_acl_message"
        _resp=$(acl_file_set_props "r")
        _err=$(echo "$_resp" | jq -r 'if type == "object" then (.error // empty) else empty end' 2>/dev/null)
        if [[ -n "$_err" ]]; then
          echo "Error: $_err" >&2; exit 1
        fi
        acl_file_format_set_response "$_resp"
        ;;
      full)
        acl_file_confirm "This will set the file to READ+WRITE via myg." "$_acl_message"
        _resp=$(acl_file_set_props "w")
        _err=$(echo "$_resp" | jq -r 'if type == "object" then (.error // empty) else empty end' 2>/dev/null)
        if [[ -n "$_err" ]]; then
          echo "Error: $_err" >&2; exit 1
        fi
        acl_file_format_set_response "$_resp"
        ;;
      *)
        echo "Unknown verb: $acl_file_verb" >&2
        echo "Usage: myg acl file id=<FILE_ID> [deny|readonly|full]" >&2
        exit 1
        ;;
    esac
  else
    echo "Usage: myg acl command [deny|allow|remove|reset] [\"<command>\"]" >&2
    echo "       myg acl file id=<FILE_ID> [deny|readonly|full]" >&2
    exit 1
  fi
  exit 0
fi


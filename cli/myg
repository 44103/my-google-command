    # Check if image output is requested
    if [[ "$m_output" == *.png || "$m_output" == *.PNG ]]; then
      params_json=$(jq -n \
        --arg from "$m_from" \
        --arg to "$m_to" \
        --arg via "$m_via" \
        --arg mode "$m_mode" \
        --arg width "$m_width" \
        --arg height "$m_height" \
        '{action: "map:route:image", from: $from, to: $to, via: $via, mode: $mode, width: $width, height: $height}')
      response=$(gas_get "$params_json")
      # Download the image from base64 data URL
      content_url=$(echo "$response" | jq -r '.contentUrl // empty')
      if [[ "$content_url" != data:image/png* ]]; then
        echo "Error: Invalid image data returned by GAS" >&2
        exit 1
      fi
      if [[ -e "$m_output" ]]; then
        echo "Error: Output file already exists: $m_output" >&2
        exit 1
      fi
      # Extract base64 data and decode
      echo "$content_url" | sed 's/^data:image\/png;base64,//' | base64 -d > "$m_output"
      echo "$m_output"
      # Open the image file (ignore errors if no display available)
      open_browser "$m_output" 2>/dev/null || true
      exit 0
    elif [[ "$m_output" == "url" ]]; then

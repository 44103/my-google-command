if [[ -n "$error_msg" ]]; then
  # Split message at ". To " or ", run:" to separate explanation from hint
  if [[ "$error_msg" == *". To "* ]]; then
    error_text="${error_msg%%". To "*}"
    hint_text="${error_msg#*". To "}"
    # Extract the command after "run: "
    hint_cmd=$(echo "$hint_text" | grep -oP '(?<=run: ).*' || true)
    echo "Error: ${error_text#*: }" >&2
    if [[ -n "$hint_cmd" ]]; then
      echo "To fix, run:" >&2
      echo "" >&2
      echo "  $hint_cmd" >&2
    fi
  else
    echo "Error: ${error_msg#*: }" >&2
  fi

  exit 1
fi


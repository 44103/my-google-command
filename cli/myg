# Permission check via .permission.json
check_permission() {
  local full_action="$1"
  local config="$SCRIPT_DIR/../.permission.json"
  [[ ! -f "$config" ]] && return 0

  if jq -e '.allow' "$config" &>/dev/null; then
    if ! jq -e --arg a "$full_action" '.allow | index($a)' "$config" &>/dev/null; then
      echo "Action '$full_action' is not in allow list. Check .permission.json" >&2
      exit 1
    fi
  fi

  if jq -e '.deny' "$config" &>/dev/null; then
    if jq -e --arg a "$full_action" '.deny | index($a)' "$config" &>/dev/null; then
      echo "Action '$full_action' is denied. Check .permission.json" >&2
      exit 1
    fi
  fi
}


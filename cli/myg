if echo "$response" | grep -qi '<html'; then
  echo "Error: Received HTML response. Your token may have expired." >&2
  echo "Run: myg auth" >&2
  exit 1
fi

# Check for error response from GAS
error_msg=$(echo "$response" | jq -r 'if type == "object" then (.error // empty) else empty end' 2>/dev/null)
if [[ -n "$error_msg" ]]; then
  # Split message at ". To " or ", run:" to separate explanation from hint
  if [[ "$error_msg" == *". To "* ]]; then
    error_text="${error_msg%%". To "*}"
    hint_text="${error_msg#*". To "}"
    # Extract the command after "run: "
    hint_cmd=$(echo "$hint_text" | grep -oP '(?<=run: ).*' || true)
    echo "Error: ${error_text#*: }" >&2
    if [[ -n "$hint_cmd" ]]; then
      echo "To fix, run:" >&2
      echo "" >&2
      echo "  $hint_cmd" >&2
    fi
  else
    echo "Error: ${error_msg#*: }" >&2
  fi

  exit 1
fi

if [[ -n "${slide_thumbnail:-}" ]]; then
  thumbnail_url=$(echo "$response" | jq -r '.contentUrl // empty')
  if [[ "$thumbnail_url" != https://* ]]; then
    echo "Error: Invalid thumbnail URL returned by GAS" >&2
    exit 1
  fi
  if [[ -z "$slide_thumbnail_output" ]]; then
    slide_thumbnail_output="slide-${si_page}.png"
  fi
  if [[ -e "$slide_thumbnail_output" ]]; then
    echo "Error: Output file already exists: $slide_thumbnail_output" >&2
    exit 1
  fi
  if ! curl -fsSL "$thumbnail_url" -o "$slide_thumbnail_output"; then
    echo "Error: Failed to download slide thumbnail" >&2
    exit 1
  fi
  echo "$slide_thumbnail_output"
  exit 0
fi

echo "$response" | jq . 2>/dev/null || echo "$response"

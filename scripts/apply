#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR/.."

# 引数があれば明示指定、なければブランチ判定
if [ -n "${1:-}" ]; then
  ENV=$1
else
  BRANCH=$(git -C "$PROJECT_DIR" rev-parse --abbrev-ref HEAD)
  if [ "$BRANCH" = "main" ]; then
    ENV=prod
  else
    ENV=dev
  fi
fi

CLASP_DIR="$PROJECT_DIR/environments/$ENV"
if [ ! -f "$CLASP_DIR/.clasp.json" ]; then
  echo "Error: $CLASP_DIR/.clasp.json not found." >&2
  echo "Run 'cp $CLASP_DIR/.clasp.json.example $CLASP_DIR/.clasp.json' and set your scriptId." >&2
  exit 1
fi

# Build
"$SCRIPT_DIR/build"

# Push
cd "$CLASP_DIR"
npx clasp push

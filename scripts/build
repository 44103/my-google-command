#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR/.."

source "$PROJECT_DIR/.env" 2>/dev/null || true

# Generate src/config.generated.ts from config.yaml (optional)
# GAS doesn't support ES modules, so we declare config as a global variable
CONFIG_YAML="$PROJECT_DIR/config.yaml"
node -e "
  const fs = require('fs');
  const yaml = require('js-yaml');
  let cfg = {};
  if (fs.existsSync('$CONFIG_YAML')) {
    cfg = yaml.load(fs.readFileSync('$CONFIG_YAML', 'utf8')) || {};
  }
  // Apply defaults
  const config = {
    aclMode: cfg.aclMode || 'blacklist',
    feedbackUrl: cfg.feedbackUrl || '',
    authMessage: cfg.authMessage || '',
    aclMessage: cfg.aclMessage || '',
  };
  const ts = 'const config = ' + JSON.stringify(config, null, 2) + ' as const;\\n';
  fs.writeFileSync('$PROJECT_DIR/src/config.generated.ts', ts);
"

rm -rf "$PROJECT_DIR/dist"
npx tsc --project "$PROJECT_DIR"

# Flatten subdirectories in dist/ (clasp requires flat structure)
# e.g. dist/docs/highlight.js -> dist/docs-highlight.js
find "$PROJECT_DIR/dist" -mindepth 2 -type f | while read -r file; do
  rel="${file#$PROJECT_DIR/dist/}"
  flat=$(echo "$rel" | sed 's|/|-|g')
  mv "$file" "$PROJECT_DIR/dist/$flat"
done
find "$PROJECT_DIR/dist" -mindepth 1 -type d -empty -delete

# Copy HTML files to dist/
find "$PROJECT_DIR/src" -name '*.html' -exec cp {} "$PROJECT_DIR/dist/" \;

node -e "
  const f = require('$PROJECT_DIR/src/appsscript.json');
  f.webapp.access = process.env.GW_ACCESS || 'DOMAIN';
  require('fs').writeFileSync('$PROJECT_DIR/dist/appsscript.json', JSON.stringify(f, null, 2));
"

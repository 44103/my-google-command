#!/usr/bin/env bash
set -euo pipefail

ENV=${1:-dev}
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR/.."
TARGET_DIR="$PROJECT_DIR/environments/$ENV"

if [ -f "$TARGET_DIR/.clasp.json" ]; then
  echo "Error: $TARGET_DIR/.clasp.json already exists." >&2
  echo "Remove it first if you want to recreate." >&2
  exit 1
fi

cd "$TARGET_DIR"

if [ "$ENV" = "prod" ]; then
  npx clasp create --title my-google-api --type standalone
else
  npx clasp create --title "my-google-api-dev" --type standalone
fi

# clasp creates .clasp.json in cwd; add rootDir pointing to dist/
SCRIPT_ID=$(python3 -c "import json; print(json.load(open('.clasp.json'))['scriptId'])")
echo "{\"scriptId\":\"$SCRIPT_ID\",\"rootDir\":\"../../dist\"}" > .clasp.json

echo ""
echo "Created: $TARGET_DIR/.clasp.json"
echo "Next: run 'yarn deploy:$ENV' to create the initial deployment."
